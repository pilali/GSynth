@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

<https://github.com/pilali/gsynth/plugin>
    a lv2:Plugin , lv2:FilterPlugin ;
    doap:name "GSynth" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    lv2:project <https://github.com/pilali/gsynth> ;
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "Input"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Output"
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "guitar" ;
        lv2:name "Guitar" ;
        lv2:default 0.7 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "octave" ;
        lv2:name "Octave (-1)" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "sub_octave" ;
        lv2:name "Sub Octave (-2)" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "square" ;
        lv2:name "Square Wave" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "attack_delay" ;
        lv2:name "Attack Delay" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 2000.0 ;
        units:unit units:ms
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "start_freq" ;
        lv2:name "Start Frequency" ;
        lv2:default 200.0 ; lv2:minimum 20.0 ; lv2:maximum 12000.0 ;
        lv2:portProperty lv2:logarithmic ;
        units:unit units:hz
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "stop_freq" ;
        lv2:name "Stop Frequency" ;
        lv2:default 2500.0 ; lv2:minimum 20.0 ; lv2:maximum 12000.0 ;
        lv2:portProperty lv2:logarithmic ;
        units:unit units:hz
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "resonance" ;
        lv2:name "Resonance" ;
        lv2:default 0.3 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "filter_rate" ;
        lv2:name "Filter Rate" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "trigger" ;
        lv2:name "Trigger Sensitivity" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 12 ;
        lv2:symbol "filter_type" ;
        lv2:name "Filter Type" ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "SVF (clean)" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Moog Ladder" ; rdf:value 1 ]
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 13 ;
        lv2:symbol "pitch_track" ;
        lv2:name "Pitch Track" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:enumeration , lv2:toggled ;
        lv2:scalePoint [ rdfs:label "Schmitt + Flip-Flops" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "YIN (CPU heavier)" ; rdf:value 1 ]
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 14 ;
        lv2:symbol "input_drive" ;
        lv2:name "Input Drive" ;
        lv2:default 0.25 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] ;

    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate       <modgui/icon-gsynth.html> ;
        modgui:stylesheet         <modgui/stylesheet-gsynth.css> ;
        modgui:screenshot         <modgui/screenshot-gsynth.png> ;
        modgui:thumbnail          <modgui/thumbnail-gsynth.png> ;
        modgui:brand              "GSynth" ;
        modgui:label              "Guitar Synth" ;
        modgui:model              "Voice + Filter" ;
        modgui:panel              "gsynth" ;
        modgui:color              "cream" ;
        modgui:knob               "black" ;
        modgui:port [
            lv2:index 2 ;
            lv2:symbol "guitar" ;
            lv2:name "Guitar"
        ] , [
            lv2:index 3 ;
            lv2:symbol "octave" ;
            lv2:name "Octave"
        ] , [
            lv2:index 4 ;
            lv2:symbol "sub_octave" ;
            lv2:name "Sub Octave"
        ] , [
            lv2:index 5 ;
            lv2:symbol "square" ;
            lv2:name "Square Wave"
        ] , [
            lv2:index 6 ;
            lv2:symbol "attack_delay" ;
            lv2:name "Attack"
        ] , [
            lv2:index 7 ;
            lv2:symbol "start_freq" ;
            lv2:name "Start"
        ] , [
            lv2:index 8 ;
            lv2:symbol "stop_freq" ;
            lv2:name "Stop"
        ] , [
            lv2:index 9 ;
            lv2:symbol "resonance" ;
            lv2:name "Resonance"
        ] , [
            lv2:index 10 ;
            lv2:symbol "filter_rate" ;
            lv2:name "Rate"
        ] , [
            lv2:index 11 ;
            lv2:symbol "trigger" ;
            lv2:name "Trigger"
        ] , [
            lv2:index 12 ;
            lv2:symbol "filter_type" ;
            lv2:name "Filter"
        ] , [
            lv2:index 13 ;
            lv2:symbol "pitch_track" ;
            lv2:name "Pitch"
        ] , [
            lv2:index 14 ;
            lv2:symbol "input_drive" ;
            lv2:name "Drive"
        ]
    ] .
