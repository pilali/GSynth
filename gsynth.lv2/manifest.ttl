@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://github.com/pilali/gsynth/plugin>
    a lv2:Plugin ;
    lv2:binary <gsynth.so> ;
    rdfs:seeAlso <gsynth.ttl> .

# --- optional-modgui (stripped for a GUI-less install / WITH_MODGUI=0) ---
# lilv only follows seeAlso declared in the manifest (not nested ones), so the
# optional MOD GUI must be referenced here. It is a standalone single-line
# statement so the Makefile can remove this whole block cleanly.
<https://github.com/pilali/gsynth/plugin> rdfs:seeAlso <modgui.ttl> .
