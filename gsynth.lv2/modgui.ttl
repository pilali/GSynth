@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

# Optional MOD GUI for GSynth.
# This file is loaded only when present (referenced from gsynth.ttl via
# rdfs:seeAlso, and from manifest.ttl).  Omit it — and the modgui/ directory —
# to install the plugin without a MOD interface.

<https://github.com/pilali/gsynth/plugin>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate       <modgui/icon-gsynth.html> ;
        modgui:stylesheet         <modgui/stylesheet-gsynth.css> ;
        modgui:screenshot         <modgui/screenshot-gsynth.png> ;
        modgui:thumbnail          <modgui/thumbnail-gsynth.png> ;
        modgui:brand              "GSynth" ;
        modgui:label              "Guitar Synth" ;
        modgui:model              "Voice + Filter" ;
        modgui:port [
            lv2:index 2 ;
            lv2:symbol "guitar" ;
            lv2:name "Guitar"
        ] , [
            lv2:index 3 ;
            lv2:symbol "octave" ;
            lv2:name "Octave"
        ] , [
            lv2:index 4 ;
            lv2:symbol "sub_octave" ;
            lv2:name "Sub Octave"
        ] , [
            lv2:index 5 ;
            lv2:symbol "square" ;
            lv2:name "Square Wave"
        ] , [
            lv2:index 6 ;
            lv2:symbol "attack_delay" ;
            lv2:name "Attack"
        ] , [
            lv2:index 7 ;
            lv2:symbol "start_freq" ;
            lv2:name "Start"
        ] , [
            lv2:index 8 ;
            lv2:symbol "stop_freq" ;
            lv2:name "Stop"
        ] , [
            lv2:index 9 ;
            lv2:symbol "resonance" ;
            lv2:name "Resonance"
        ] , [
            lv2:index 10 ;
            lv2:symbol "filter_rate" ;
            lv2:name "Rate"
        ] , [
            lv2:index 11 ;
            lv2:symbol "trigger" ;
            lv2:name "Trigger"
        ] , [
            lv2:index 12 ;
            lv2:symbol "filter_type" ;
            lv2:name "Filter"
        ] , [
            lv2:index 13 ;
            lv2:symbol "pitch_track" ;
            lv2:name "Pitch"
        ] , [
            lv2:index 14 ;
            lv2:symbol "input_drive" ;
            lv2:name "Drive"
        ]
    ] .
